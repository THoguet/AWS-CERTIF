# Elastic Beanstalk reads every .config file in .ebextensions/ at the root of the source bundle.
option_settings:
  aws:autoscaling:asg:
    MinSize: 2                     # two instances, so that deployments have something to roll over
    MaxSize: 2
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling      # AllAtOnce | Rolling | RollingWithAdditionalBatch | Immutable | TrafficSplitting
    BatchSizeType: Fixed
    BatchSize: 1
  aws:elasticbeanstalk:application:environment:
    COLOR: blue                    # becomes an environment variable for the application
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
